# Lead Ops Dashboard - Frontend
# Copy to .env.local

# Backend API URL (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Spline 3D scene URL for hero section (optional - uses Three.js if not set)
# Export from Spline: Export → Code → React, then paste the scene URL
# Example: https://prod.spline.design/YOUR-SCENE-ID/scene.splinecode
NEXT_PUBLIC_SPLINE_SCENE_URL=https://prod.spline.design/ZIiRnoiLRPm5ekhh/scene.splinecode
